generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Administrador
  Cajero
  Generico
}

enum ClientStatus {
  Activo
  Desactivado
}

enum PaymentPeriod {
  Semanal
  Quincenal
  Mensual
  DiaFijo
}

enum OperationStatus {
  Activo
  Anulado
}

enum PaymentMethod {
  Efectivo
  Tarjeta
  Transferencia
}

enum LoanStatus {
  Activo
  Pagado
  Vencido
  Anulado
}

enum InstallmentStatus {
  Pendiente
  Pagada
  Parcial
  Vencida
  Anulada
}

model User {
  id         String    @id @default(uuid())
  name       String
  email      String    @unique
  password   String
  role       UserRole
  roleId     String?
  roleEntity Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  avatar     String?
  active     Boolean   @default(true)
  approved   Boolean   @default(false)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Client {
  id             String          @id @default(uuid())
  clientNumber   String          @unique
  name           String
  phone          String          @default("")
  address        String          @default("")
  creditLimit    Float           @default(0)
  currentBalance Float           @default(0)
  dailyDebtBalance    Decimal?                 @db.Decimal(12, 2)
  bankDebtBalance     Decimal?                 @db.Decimal(12, 2)
  balanceModelVersion String?
  balanceOrigin       String?
  openingSnapshots    BalanceOpeningSnapshot[]
  adjustments         BalanceAdjustment[]
  paymentPeriod  PaymentPeriod   @default(Mensual)
  paymentDay     String          @default("")
  nextDueDate    String          @default("")
  status         ClientStatus    @default(Activo)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchases      CreditPurchase[]
  payments       Payment[]
  loans          Loan[]
}

model Loan {
  id                    String            @id @default(uuid())
  code                  String            @unique
  clientId              String
  client                Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date                  DateTime          @default(now())
  product               String?
  capital               Float
  interestRate          Float
  interestAmount        Float
  totalAmount           Float
  installmentsCount     Int
  installmentAmount     Float
  frequency             PaymentPeriod
  firstDueDate          String
  paidAmount            Float             @default(0)
  pendingAmount         Float
  paidInstallmentsCount Int               @default(0)
  status                LoanStatus        @default(Activo)
  ticketNumber          String?
  registeredBy          String
  notes                 String?
  annulledAt            DateTime?
  annulledBy            String?
  annulmentReason       String?
  installments          Installment[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  purchases             CreditPurchase[]
  payments              Payment[]
  adjustments           BalanceAdjustment[]
}

model Installment {
  id                String            @id @default(uuid())
  loanId            String
  loan              Loan              @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           String            // YYYY-MM-DD
  capital           Float
  interest          Float
  amount            Float
  paidAmount        Float             @default(0)
  status            InstallmentStatus @default(Pendiente)
  paidDate          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CreditPurchase {
  id                 String          @id @default(uuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date               DateTime        @default(now())
  createdAt          DateTime?       @default(now())
  isBaselineMovement Boolean         @default(false)
  product            String
  unitPrice          Float
  quantity           Int             @default(1)
  amount             Float
  ticketNumber       String?
  registeredBy       String
  status             OperationStatus @default(Activo)
  annulledAt         DateTime?
  annulledBy         String?
  annulmentReason    String?
  debtType           String          @default("simple") // "simple" or "credit"
  loanId             String?
  loan               Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
}

enum PaymentStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

model Payment {
  id                 String              @id @default(uuid())
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date               DateTime            @default(now())
  createdAt          DateTime?           @default(now())
  isBaselineMovement Boolean             @default(false)
  amount             Float
  previousBalance    Float
  resultingBalance   Float
  paymentMethod      PaymentMethod       @default(Efectivo)
  cardSurcharge      Float?
  totalCharged       Float
  registeredBy       String
  status             OperationStatus     @default(Activo)
  notes              String?
  targetType         String?
  allocations        Json?
  annulledAt         DateTime?
  annulledBy         String?
  annulmentReason    String?
  loanId             String?
  loan               Loan?               @relation(fields: [loanId], references: [id], onDelete: SetNull)
  approvedStatus     PaymentStatus       @default(APPROVED)
  createdByUserId    String?
  approvedByUserId   String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  adjustments        BalanceAdjustment[]
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String
  userName  String
  userRole  String
  action    String
  details   String
  targetId  String?
  ip        String?
}

model BalanceOpeningSnapshot {
  id                         String   @id @default(uuid())
  clientId                   String
  client                     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  migrationVersion           String
  cutOffDate                 DateTime
  dailyDebtOpeningBalance    Decimal  @db.Decimal(12, 2)
  bankDebtOpeningBalance     Decimal  @db.Decimal(12, 2)
  currentOpeningBalance      Decimal  @db.Decimal(12, 2)
  creditExposureOpening      Decimal  @db.Decimal(12, 2)
  legacyUnknownPaymentCount  Int      @default(0)
  legacyMixedPaymentCount    Int      @default(0)
  status                     String   @default("ACTIVO")
  reconciliationRef          String?
  createdAt                  DateTime @default(now())

  @@unique([clientId, migrationVersion])
}

enum BalanceAdjustmentType {
  DAILY_DEBT_REVERSAL
  DAILY_PAYMENT_REVERSAL
  BANK_LOAN_REVERSAL
  BANK_PAYMENT_REVERSAL
  MIGRATION_ADJUSTMENT
}

model BalanceAdjustment {
  id         String                @id @default(uuid())
  clientId   String
  client     Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       BalanceAdjustmentType
  amount     Decimal               @db.Decimal(12, 2)
  sourceType String
  sourceId   String
  loanId     String?
  loan       Loan?                 @relation(fields: [loanId], references: [id], onDelete: SetNull)
  paymentId  String?
  payment    Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  purchaseId String?
  reason     String
  createdAt  DateTime              @default(now())
  createdBy  String
  status     String                @default("ACTIVO")

  @@unique([sourceType, sourceId, type], name: "source_adjustment_unique")
}

// =========================================================================
// MÓDULO PRODUCTOS E INVENTARIO - BASE DEL DOMINIO (ENTREGA 1)
// =========================================================================

enum LocationType {
  STORE
  WAREHOUSE
}

enum ProductSaleType {
  UNIT
  WEIGHT
  KIT
}

model Location {
  id          String       @id @default(uuid())
  businessId  String       @default("default")
  name        String
  code        String?
  address     String?
  type        LocationType @default(STORE)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@index([businessId, active])
}

model Department {
  id          String    @id @default(uuid())
  businessId  String    @default("default")
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

model Supplier {
  id          String    @id @default(uuid())
  businessId  String    @default("default")
  name        String
  taxId       String?
  phone       String?
  email       String?
  address     String?
  contactName String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId, active])
}

model Product {
  id              String          @id @default(uuid())
  businessId      String          @default("default")
  sku             String
  barcode         String?
  name            String
  description     String?
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  saleType        ProductSaleType @default(UNIT)
  costPrice       Decimal         @default(0) @db.Decimal(12, 4)
  salePrice       Decimal         @default(0) @db.Decimal(12, 4)
  wholesalePrice  Decimal         @default(0) @db.Decimal(12, 4)
  tracksInventory Boolean         @default(true)
  defaultMinStock Decimal?        @default(0) @db.Decimal(12, 3)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  kitComponents   ProductKitComponent[] @relation("KitParent")
  componentOfKits ProductKitComponent[] @relation("ComponentProduct")

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, active])
}

model ProductKitComponent {
  id                 String   @id @default(uuid())
  kitProductId       String
  kitProduct         Product  @relation("KitParent", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product  @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)
  quantity           Decimal  @db.Decimal(12, 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([kitProductId, componentProductId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  module      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}
